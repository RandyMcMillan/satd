#!/usr/bin/env bash
# Detect build dependencies and configure .cargo/config.toml.
# Run once after cloning or when changing toolchains.
set -e

CARGO_DIR=".cargo"
CONFIG="$CARGO_DIR/config.toml"
VERIFY_CMD="check"
VERIFY_JOBS=""

detect_jobs() {
    if command -v nproc &>/dev/null; then
        nproc
        return
    fi

    case "$(uname -s)" in
        Darwin)
            sysctl -n hw.ncpu
            ;;
        *)
            getconf _NPROCESSORS_ONLN
            ;;
    esac
}

for arg in "$@"; do
    case "$arg" in
        --build)
            VERIFY_CMD="build"
            ;;
        -j|--jobs)
            echo "ERROR: Missing value for $arg"
            echo "Usage: ./configure [--build] [-j N]"
            exit 1
            ;;
        -j=*|--jobs=*)
            VERIFY_JOBS="${arg#*=}"
            ;;
        -j*)
            VERIFY_JOBS="${arg#-j}"
            ;;
        -h|--help)
            echo "Usage: ./configure [--build] [-j N]"
            echo "  --build  run cargo build instead of cargo check"
            echo "  -j N     pass N to cargo for parallel jobs; omit N for auto-detect"
            exit 0
            ;;
        *)
            echo "ERROR: Unknown option: $arg"
            echo "Usage: ./configure [--build] [-j N]"
            exit 1
            ;;
    esac
done

echo "Checking build dependencies..."

# Check for C/C++ compiler
if ! command -v cc &>/dev/null && ! command -v gcc &>/dev/null; then
    echo "ERROR: No C compiler found. Install build-essential:"
    echo "  sudo apt install build-essential"
    exit 1
fi

# Check for Rust
if ! command -v cargo &>/dev/null; then
    echo "ERROR: cargo not found. Install Rust: https://rustup.rs"
    exit 1
fi

# Find GCC include path (needed by bindgen for stddef.h)
GCC_INCLUDE=""
for dir in /usr/lib/gcc/x86_64-linux-gnu/*/include /usr/lib/gcc/aarch64-linux-gnu/*/include; do
    if [ -f "$dir/stddef.h" ]; then
        GCC_INCLUDE="$dir"
        break
    fi
done

# Check if libclang-common headers are available (makes the workaround unnecessary)
CLANG_HAS_STDDEF=false
for dir in /usr/lib/clang/*/include; do
    if [ -f "$dir/stddef.h" ]; then
        CLANG_HAS_STDDEF=true
        break
    fi
done

OS="$(uname -s)"

mkdir -p "$CARGO_DIR"

if [ "$OS" = "Darwin" ]; then
    LIBCLANG_DIR=""
    XCODE_DIR="$(xcode-select -p 2>/dev/null || true)"
    for dir in \
        "${XCODE_DIR}/Toolchains/XcodeDefault.xctoolchain/usr/lib" \
        "${XCODE_DIR}/usr/lib" \
        /Library/Developer/CommandLineTools/usr/lib \
        /usr/local/opt/llvm/lib \
        /opt/homebrew/opt/llvm/lib
    do
        if [ -f "$dir/libclang.dylib" ]; then
            LIBCLANG_DIR="$dir"
            break
        fi
    done

    if [ -z "$LIBCLANG_DIR" ]; then
        echo "WARNING: Could not find libclang.dylib in Xcode or Command Line Tools paths."
        echo "  Install Xcode Command Line Tools or Xcode so libclang is available."
        cat > "$CONFIG" <<'EOF'
# WARNING: libclang.dylib not found. librocksdb-sys may fail on macOS.
# Install Xcode Command Line Tools or Xcode, then rerun ./configure.
EOF
    else
        echo "  libclang library found: $LIBCLANG_DIR"
        SDKROOT=""
        if command -v xcrun &>/dev/null; then
            SDKROOT="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
        fi

        export LIBCLANG_PATH="$LIBCLANG_DIR"
        export DYLD_LIBRARY_PATH="$LIBCLANG_DIR${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
        export DYLD_FALLBACK_LIBRARY_PATH="$LIBCLANG_DIR${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
        if [ -n "$SDKROOT" ]; then
            export BINDGEN_EXTRA_CLANG_ARGS="-isysroot ${SDKROOT}"
        fi

        cat > "$CONFIG" <<EOF
[env]
LIBCLANG_PATH = "$LIBCLANG_DIR"
DYLD_LIBRARY_PATH = "$LIBCLANG_DIR"
DYLD_FALLBACK_LIBRARY_PATH = "$LIBCLANG_DIR"
EOF
        if [ -n "$SDKROOT" ]; then
            cat >> "$CONFIG" <<EOF
BINDGEN_EXTRA_CLANG_ARGS = "-isysroot ${SDKROOT}"
EOF
        fi
    fi
elif [ "$CLANG_HAS_STDDEF" = true ]; then
    echo "  libclang headers found — no workaround needed"
    cat > "$CONFIG" <<'EOF'
# No special configuration needed — libclang headers are available.
EOF
elif [ -n "$GCC_INCLUDE" ]; then
    echo "  GCC include path: $GCC_INCLUDE"
    cat > "$CONFIG" <<EOF
[env]
# Points bindgen at GCC's stddef.h (auto-detected by ./configure).
# Install libclang-common-*-dev to remove this workaround.
BINDGEN_EXTRA_CLANG_ARGS = "-I${GCC_INCLUDE}"
EOF
else
    echo "WARNING: Could not find stddef.h in GCC or clang paths."
    echo "  RocksDB build may fail. Try: sudo apt install libclang-common-18-dev"
    cat > "$CONFIG" <<'EOF'
# WARNING: stddef.h not found. RocksDB build may fail.
# Install libclang-common-*-dev or set BINDGEN_EXTRA_CLANG_ARGS manually.
EOF
fi

echo "  Rust: $(rustc --version)"
echo "  Cargo config: $CONFIG"
echo ""

# Verify the build works
if [ "${CI:-false}" = "true" ]; then
    echo "Skipping cargo ${VERIFY_CMD} in CI."
else
    if [ -z "$VERIFY_JOBS" ] || [ "$VERIFY_JOBS" = "auto" ] || [ "$VERIFY_JOBS" = "nproc" ]; then
        VERIFY_JOBS="$(detect_jobs)"
    fi
    echo "Running cargo ${VERIFY_CMD}..."
    CHECK_LOG="$(mktemp -t satd-cargo-check.XXXXXX)"
    if cargo "$VERIFY_CMD" -j "$VERIFY_JOBS" >"$CHECK_LOG" 2>&1; then
        CHECK_STATUS=0
    else
        CHECK_STATUS=$?
    fi
    tail -3 "$CHECK_LOG"
    rm -f "$CHECK_LOG"
    if [ "$CHECK_STATUS" -eq 0 ]; then
        echo ""
        echo "Build OK. Run tests with: cargo test"
    else
        echo ""
        echo "Build failed. See errors above."
        exit "$CHECK_STATUS"
    fi
fi
